# ==========================================
# Go Binaries and Build Outputs
# ==========================================
# Compiled binaries/executables
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries and coverage reports
*.test
*.out
coverage.txt
coverage.html

# Common Go build directories
/bin/
/dist/
/out/

# Delve (Go Debugger) temporary binaries
__debug_bin

# ==========================================
# Dependencies
# ==========================================
# Go modules are cached globally by default. If you use 'go mod vendor', 
# uncomment the line below ONLY if you don't want to commit your vendor folder.
# vendor/

# ==========================================
# IDEs and Editors
# ==========================================

# JetBrains (GoLand, IntelliJ IDEA)
.idea/
*.iml
*.iws

# Visual Studio Code
.vscode/
!.vscode/extensions.json
*.code-workspace

# SublimeText / Vim
*.sublime-project
*.sublime-workspace
*~
*.swp
*.swo

# ==========================================
# Environment Variables and Secrets
# ==========================================
# NEVER commit sensitive credentials to version control.
.env
.env.*
!.env.example
config.local.yaml
secrets.json

# ==========================================
# Operating System Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.fuse_hidden*
.directory
# Bare compiled binary (go build output at repo root)
/authserver

# ==========================================
# Local dev database (scripts/dev.sh / make dev)
# ==========================================
*.db
*.db-shm
*.db-wal
/dev.db*

# Background-process pidfiles (make start / make start-all)
/.authserver.pid
/.democlient.pid
/.web.pid
loginflow
plan-2.md

# Web SPA (web/, pnpm)
web/node_modules/
web/dist/

# Server-only deployment secrets and state
/deploy/authserver.env
/deploy/.current-image
/deploy/.previous-image
/deploy/.current-web-image
/deploy/.previous-web-image
/deploy/.last-good-compose.yml
/deploy/.deploy.lock
/deploy/.deploy-backup.*/
/deploy/.caddy-backup-*/
/deploy/.proxy.lock
__pycache__/
