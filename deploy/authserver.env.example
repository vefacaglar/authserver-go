# Raw Docker env file: do not quote values or use shell substitutions.
# Set AUTH_DB_DSN and AUTH_ADMIN_TOKEN as separate GitHub Actions secrets,
# or save the complete contents as the optional AUTH_ENV secret.
# CD transfers it on every deployment; no manual server file is needed.
# Preserve the current production database, including signing and cookie keys.
AUTH_DB_DSN=postgres://authserver:REPLACE_ME@postgres:5432/authserver?sslmode=require
AUTH_ADMIN_TOKEN=REPLACE_WITH_A_RANDOM_SECRET
# Copy current SMTP settings to keep password reset email working.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=

# Optional shared Typesense application logs. Use a collection-scoped write key.
AUTH_LOG_TYPESENSE_URL=
AUTH_LOG_TYPESENSE_API_KEY=
