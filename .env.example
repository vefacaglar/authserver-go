# =============================================================================
# go-authserver environment configuration
# =============================================================================
# Copy to .env and adjust values for your environment:
#   cp .env.example .env
# Then start with: make dev  (or: bash scripts/dev.sh)
#
# Every AUTH_* key read by internal/config/config.go is listed below.
# Blank values are allowed — scripts/dev.sh generates ephemeral secrets
# for any key left empty.
# =============================================================================

# --- server ---
AUTH_ISSUER=http://localhost:5175
AUTH_LISTEN_ADDR=:5175
AUTH_REQUIRE_HTTPS=false

# --- database ---
# sqlite (dev default):
#   AUTH_DB_DRIVER=sqlite
#   AUTH_DB_DSN=file:./dev.db
# postgres (prod):
AUTH_DB_DRIVER=sqlite
AUTH_DB_DSN=file:./dev.db
# AUTH_DB_DRIVER=postgres
# AUTH_DB_DSN=postgres://authserver:CHANGE_ME@localhost:5432/authserver?sslmode=disable

# --- secrets (base64, 32 bytes each) ---
# Generate with: head -c 32 /dev/urandom | base64
# Leave blank and scripts/dev.sh will generate ephemeral keys.
AUTH_COOKIE_HASH_KEY=
AUTH_COOKIE_BLOCK_KEY=
AUTH_CSRF_KEY=

# --- admin login ---
# Token mode (prod): set a strong token; sent as Authorization: Bearer <token>.
# Leave blank and scripts/dev.sh will generate an ephemeral token.
AUTH_ADMIN_TOKEN=
# Dev convenience: when true, the admin console needs no token.
# NEVER set true in production.
AUTH_ADMIN_ALLOW_ANONYMOUS=true

# --- session cookie ---
AUTH_COOKIE_NAME=.auth.session

# --- paths ---
AUTH_LOGIN_PATH=/login
AUTH_LOGOUT_PATH=/logout
AUTH_POST_LOGOUT_REDIRECT_URI=/

# --- token lifetimes ---
AUTH_AUTH_CODE_LIFETIME=60s
AUTH_ACCESS_TOKEN_LIFETIME=1h
AUTH_ID_TOKEN_LIFETIME=1h
AUTH_REFRESH_TOKEN_LIFETIME=720h
AUTH_REFRESH_TOKEN_ABS_LIFETIME=720h

# --- security tuning ---
AUTH_DETECT_REFRESH_REUSE=true
AUTH_CLIENT_ASSERTION_CLOCK_SKEW=60s
AUTH_REQUIRE_PKCE=true
AUTH_LOGIN_RATE_LIMIT=10
