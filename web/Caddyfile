# Static file server for the SPA build. Runs behind the main Caddy,
# which terminates TLS and routes API paths to the Go server; every
# other path lands here. Unknown paths fall back to index.html so
# client-side routing works on refresh/deep links.
:8080 {
	root * /srv
	encode gzip

	# Same baseline as the Go server's securityHeadersMiddleware, so the
	# login/consent pages cannot be framed (clickjacking) or sniffed. HSTS
	# is set by the TLS-terminating edge proxy, not here.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# Missing bundles must return 404, never cache the SPA HTML as JavaScript.
	handle /assets/* {
		@existing file
		header @existing Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		# Deep links serve the same HTML and need the same cache policy.
		header Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}
}
