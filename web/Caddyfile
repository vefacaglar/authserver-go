# Static file server for the SPA build. Runs behind the main Caddy,
# which terminates TLS and routes API paths to the Go server; every
# other path lands here. Unknown paths fall back to index.html so
# client-side routing works on refresh/deep links.
:8080 {
	root * /srv
	encode gzip

	# Missing bundles must return 404, never cache the SPA HTML as JavaScript.
	handle /assets/* {
		@existing file
		header @existing Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		# Deep links serve the same HTML and need the same cache policy.
		header Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}
}
